{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "components": {
    "schemas": {
      "AdminEnrollmentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "courseCode",
          "enrollmentType",
          "status",
          "enrolledAt",
          "activeEnrollmentCount",
          "capacity",
          "overCapacity"
        ],
        "properties": {
          "enrollmentType": {
            "$ref": "#/components/schemas/EnrollmentType",
            "const": "ADMIN"
          },
          "activeEnrollmentCount": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "$ref": "#/components/schemas/EnrollmentStatus",
            "const": "ENROLLED"
          },
          "studentId": {
            "$ref": "#/components/schemas/UserId"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "enrolledAt": {
            "type": "string",
            "format": "date-time"
          },
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          },
          "overCapacity": {
            "type": "boolean"
          }
        }
      },
      "CourseCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode",
          "name",
          "category",
          "evaluationType",
          "capacity",
          "minimumEnrollment",
          "classroom"
        ],
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CourseCategory"
          },
          "minimumEnrollment": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "evaluationType": {
            "$ref": "#/components/schemas/EvaluationType"
          },
          "classroom": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "TicketReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticketId",
          "requestType",
          "status",
          "submittedAt",
          "statusUrl"
        ],
        "properties": {
          "ticketId": {
            "$ref": "#/components/schemas/TicketId"
          },
          "statusUrl": {
            "$ref": "#/components/schemas/StatusUrl"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/TicketReceiptStatus"
          },
          "requestType": {
            "type": "string",
            "enum": [
              "ADMISSION",
              "ENROLLMENT",
              "CANCELLATION"
            ]
          }
        }
      },
      "TicketReceiptStatus": {
        "type": "string",
        "enum": [
          "RECEIVED",
          "WAITING"
        ]
      },
      "TicketId": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "CoursePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "properties": {
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "const": 20
          }
        }
      },
      "CourseCategory": {
        "type": "string",
        "enum": [
          "GENERAL",
          "MAJOR"
        ]
      },
      "AdminEnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "courseCode"
        ],
        "properties": {
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          },
          "studentId": {
            "$ref": "#/components/schemas/UserId"
          }
        }
      },
      "CourseClosureItemResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode",
          "code",
          "closedEnrollmentCount"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "const": "OK"
                }
              }
            },
            "then": {
              "properties": {
                "closedEnrollmentCount": {
                  "type": "integer"
                }
              }
            },
            "else": {
              "properties": {
                "closedEnrollmentCount": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          },
          "closedEnrollmentCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "code": {
            "$ref": "#/components/schemas/CourseClosureItemCode"
          }
        }
      },
      "AdmissionState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "admittedAt"
        ],
        "properties": {
          "admittedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketResultCode": {
        "type": "string",
        "enum": [
          "OK",
          "E01",
          "E02",
          "E04",
          "E05",
          "E06",
          "E07",
          "E08",
          "E15",
          "E99"
        ]
      },
      "AuthenticatedUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "name",
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "ClosureCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode",
          "name",
          "professorName",
          "activeEnrollmentCount",
          "minimumEnrollment",
          "capacity"
        ],
        "properties": {
          "minimumEnrollment": {
            "type": "integer",
            "minimum": 1
          },
          "activeEnrollmentCount": {
            "type": "integer",
            "minimum": 0
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "professorName": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          }
        }
      },
      "CourseList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        }
      },
      "CourseCategoryFilter": {
        "type": "string",
        "enum": [
          "ALL",
          "GENERAL",
          "MAJOR"
        ],
        "default": "ALL"
      },
      "StatusUrl": {
        "type": "string",
        "format": "uri-reference",
        "pattern": "^/api/v1/tickets/[1-9][0-9]*$"
      },
      "MyEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode",
          "name",
          "category",
          "professorName",
          "classroom",
          "enrollmentType",
          "enrolledAt",
          "status"
        ],
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CourseCategory"
          },
          "status": {
            "$ref": "#/components/schemas/EnrollmentStatus",
            "const": "ENROLLED"
          },
          "enrollmentType": {
            "$ref": "#/components/schemas/EnrollmentType"
          },
          "classroom": {
            "type": "string",
            "minLength": 1
          },
          "enrolledAt": {
            "type": "string",
            "format": "date-time"
          },
          "professorName": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "field",
          "message"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "BODY",
              "QUERY",
              "PATH"
            ]
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "EnrollmentType": {
        "type": "string",
        "enum": [
          "STUDENT",
          "ADMIN"
        ]
      },
      "CourseClosureResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course",
          "closedEnrollmentCount"
        ],
        "properties": {
          "course": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Course"
              },
              {
                "properties": {
                  "status": {
                    "const": "CLOSED"
                  }
                }
              }
            ]
          },
          "closedEnrollmentCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "EnrollmentStatus": {
        "type": "string",
        "enum": [
          "ENROLLED",
          "CLOSED"
        ]
      },
      "CourseClosureBatchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CourseClosureItemResult"
            }
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "enum": [
          "E01",
          "E02",
          "E03",
          "E04",
          "E05",
          "E06",
          "E09",
          "E10",
          "E11",
          "E13",
          "E14",
          "E15",
          "INTERNAL_ERROR"
        ]
      },
      "CourseClosureBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCodes"
        ],
        "properties": {
          "courseCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/CourseCode"
            }
          }
        }
      },
      "ClosureCandidatePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "properties": {
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/ClosureCandidate"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "const": 20
          }
        }
      },
      "CourseStatus": {
        "type": "string",
        "enum": [
          "OPEN",
          "CLOSED"
        ]
      },
      "Ticket": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticketId",
          "requestType",
          "courseCode",
          "submittedAt",
          "status",
          "queuePosition",
          "result"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "requestType": {
                  "enum": [
                    "ENROLLMENT",
                    "CANCELLATION"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "courseCode": {
                  "$ref": "#/components/schemas/CourseCode"
                }
              }
            },
            "else": {
              "properties": {
                "courseCode": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "WAITING"
                }
              }
            },
            "then": {
              "properties": {
                "queuePosition": {
                  "type": "integer"
                }
              }
            },
            "else": {
              "properties": {
                "queuePosition": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "SUCCEEDED",
                    "REJECTED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "$ref": "#/components/schemas/TicketResult"
                }
              }
            },
            "else": {
              "properties": {
                "result": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SUCCEEDED"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "code": {
                      "const": "OK"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "REJECTED"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "code": {
                      "not": {
                        "const": "OK"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "requestType": {
                  "const": "LOGIN"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "code": {
                      "enum": [
                        "OK",
                        "E01",
                        "E99"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "requestType": {
                  "const": "ADMISSION"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "code": {
                      "enum": [
                        "OK",
                        "E02",
                        "E99"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "requestType": {
                  "const": "ENROLLMENT"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "code": {
                      "enum": [
                        "OK",
                        "E02",
                        "E04",
                        "E05",
                        "E06",
                        "E07",
                        "E15",
                        "E99"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "requestType": {
                  "const": "CANCELLATION"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "code": {
                      "enum": [
                        "OK",
                        "E02",
                        "E04",
                        "E05",
                        "E08",
                        "E15",
                        "E99"
                      ]
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "queuePosition": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "ticketId": {
            "$ref": "#/components/schemas/TicketId"
          },
          "courseCode": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CourseCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TicketResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "requestType": {
            "$ref": "#/components/schemas/TicketRequestType"
          }
        }
      },
      "CourseCode": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{1,10}$"
      },
      "EnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode"
        ],
        "properties": {
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          }
        }
      },
      "MyEnrollmentList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyEnrollment"
            }
          }
        }
      },
      "TicketRequestType": {
        "type": "string",
        "enum": [
          "LOGIN",
          "ADMISSION",
          "ENROLLMENT",
          "CANCELLATION"
        ]
      },
      "ServiceSettingsUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concurrencyLimit"
        ],
        "properties": {
          "concurrencyLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "EvaluationType": {
        "type": "string",
        "enum": [
          "RELATIVE",
          "ABSOLUTE",
          "PASS_FAIL"
        ]
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "RECEIVED",
          "WAITING",
          "PROCESSING",
          "SUCCEEDED",
          "REJECTED"
        ]
      },
      "SessionState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expiresAt",
          "admittedAt"
        ],
        "properties": {
          "admittedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ServiceSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concurrencyLimit",
          "activeSlots",
          "availableSlots",
          "waitingCount",
          "lastChangedBy",
          "lastChangedAt"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "lastChangedBy": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "lastChangedAt": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "lastChangedAt": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "lastChangedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "concurrencyLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "waitingCount": {
            "type": "integer",
            "minimum": 0
          },
          "availableSlots": {
            "type": "integer",
            "minimum": 0
          },
          "lastChangedBy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserId"
              },
              {
                "type": "null"
              }
            ]
          },
          "activeSlots": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AuthFailureReason": {
        "type": "string",
        "enum": [
          "ACCESS_TOKEN_EXPIRED",
          "SESSION_REVOKED",
          "SESSION_EXPIRED",
          "REFRESH_TOKEN_INVALID",
          "REFRESH_TOKEN_REUSED",
          "LOGIN_PROOF_INVALID",
          "LOGIN_PROOF_EXPIRED",
          "LOGIN_EXCHANGE_CONSUMED",
          "CSRF_CHECK_FAILED",
          "FORBIDDEN"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user",
          "session"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "user": {
                  "properties": {
                    "role": {
                      "not": {
                        "const": "STUDENT"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "session": {
                  "properties": {
                    "admittedAt": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "session": {
            "$ref": "#/components/schemas/SessionState"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUser"
          },
          "accessToken": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "CourseUpdateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "evaluationType",
          "capacity",
          "minimumEnrollment",
          "classroom"
        ],
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CourseCategory"
          },
          "minimumEnrollment": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "evaluationType": {
            "$ref": "#/components/schemas/EvaluationType"
          },
          "classroom": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "UserId": {
        "type": "string",
        "minLength": 1
      },
      "LoginTicketReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticketId",
          "requestType",
          "status",
          "submittedAt",
          "statusUrl",
          "credentialExpiresAt",
          "proofExpiresAt"
        ],
        "properties": {
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/TicketReceiptStatus"
          },
          "ticketId": {
            "$ref": "#/components/schemas/TicketId"
          },
          "statusUrl": {
            "$ref": "#/components/schemas/StatusUrl"
          },
          "credentialExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "proofExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "requestType": {
            "$ref": "#/components/schemas/TicketRequestType",
            "const": "LOGIN"
          }
        }
      },
      "TicketResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "completedAt"
        ],
        "properties": {
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "code": {
            "$ref": "#/components/schemas/TicketResultCode"
          }
        }
      },
      "Course": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseCode",
          "name",
          "category",
          "professorName",
          "evaluationType",
          "capacity",
          "minimumEnrollment",
          "activeEnrollmentCount",
          "remainingSeats",
          "classroom",
          "status"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CLOSED"
                }
              }
            },
            "then": {
              "properties": {
                "activeEnrollmentCount": {
                  "const": 0
                }
              }
            }
          }
        ],
        "properties": {
          "category": {
            "$ref": "#/components/schemas/CourseCategory"
          },
          "minimumEnrollment": {
            "type": "integer",
            "minimum": 1
          },
          "activeEnrollmentCount": {
            "type": "integer",
            "minimum": 0
          },
          "evaluationType": {
            "$ref": "#/components/schemas/EvaluationType"
          },
          "classroom": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "$ref": "#/components/schemas/CourseStatus"
          },
          "professorName": {
            "type": "string",
            "minLength": 1
          },
          "remainingSeats": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "courseCode": {
            "$ref": "#/components/schemas/CourseCode"
          },
          "enrolled": {
            "type": "boolean"
          }
        }
      },
      "CourseClosureItemCode": {
        "type": "string",
        "enum": [
          "OK",
          "E02",
          "E04",
          "E14"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "STUDENT",
          "PROFESSOR",
          "ADMIN"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E02"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E03"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "activeTicketId"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E09"
                }
              }
            },
            "then": {
              "required": [
                "violations"
              ],
              "properties": {
                "status": {
                  "const": 400
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "violations"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E01"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 401
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E02"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "enum": [
                    401,
                    403
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "enum": [
                    "E03",
                    "E05",
                    "E06",
                    "E10",
                    "E11",
                    "E14",
                    "E15"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 409
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E04"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 404
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E13"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 422
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "INTERNAL_ERROR"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 500
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "ACCESS_TOKEN_EXPIRED",
                    "SESSION_REVOKED",
                    "SESSION_EXPIRED",
                    "REFRESH_TOKEN_INVALID",
                    "REFRESH_TOKEN_REUSED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 401
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "LOGIN_PROOF_INVALID",
                    "LOGIN_PROOF_EXPIRED",
                    "LOGIN_EXCHANGE_CONSUMED",
                    "CSRF_CHECK_FAILED",
                    "FORBIDDEN"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": 403
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "code": {
                  "const": "E02"
                },
                "status": {
                  "const": 403
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "$ref": "#/components/schemas/AuthFailureReason"
          },
          "type": {
            "type": "string",
            "format": "uri"
          },
          "activeTicketId": {
            "$ref": "#/components/schemas/TicketId"
          },
          "violations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "password"
        ],
        "properties": {
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "format": "password",
            "writeOnly": true
          }
        }
      }
    }
  }
}
